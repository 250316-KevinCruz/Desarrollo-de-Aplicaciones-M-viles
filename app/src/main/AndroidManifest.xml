<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClinicaVeterinaria">

        <!-- Pantalla de inicio: Login -->
        <activity
            android:name=".Login"
            android:exported="true"
            android:theme="@style/Theme.ClinicaVeterinaria"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla principal -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla de registro -->
        <activity
            android:name=".Registro"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Recuperación de contraseña -->
        <activity
            android:name=".RecuperarContrasena"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".RegistroCliente"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ActualizarCliente"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".DatosCliente"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Inicio"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Menu"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".RegistroMascota"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ActualizarMascota"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".DatosMascota"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".RegistroDiagnostico"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ActualizarDiagnostico"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".DatosDiagnostico"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MenuPrincipal"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>