<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DAF1DE"
    tools:context=".Registro">

    <!-- Encabezado Fijo -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/vet"
                android:scaleType="centerCrop"
                android:contentDescription="Logo Clínica" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/lblTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REGISTRO DE USUARIO"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#051F20" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clinica del Tio Randy"
                android:textSize="13sp"
                android:textColor="#163832" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="36dp">

            <TextView
                android:id="@+id/lbLNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Nombre:"
                android:textColor="#051F20"
                android:textStyle="bold"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/txtNombre"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="#FFFFFF"
                android:textColor="#051F20"
                android:paddingHorizontal="14dp"
                android:elevation="1dp"
                android:inputType="textPersonName" />

            <TextView
                android:id="@+id/lblApellidos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Apellidos:"
                android:textColor="#051F20"
                android:textStyle="bold"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/txtApellidos"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="#FFFFFF"
                android:textColor="#051F20"
                android:paddingHorizontal="14dp"
                android:elevation="1dp"
                android:inputType="textPersonName" />

            <TextView
                android:id="@+id/lblDireccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Dirección:"
                android:textColor="#051F20"
                android:textStyle="bold"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/txtDireccion"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="#FFFFFF"
                android:textColor="#051F20"
                android:paddingHorizontal="14dp"
                android:elevation="1dp"
                android:inputType="textPostalAddress" />

            <TextView
                android:id="@+id/lblTelefono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Teléfono:"
                android:textColor="#051F20"
                android:textStyle="bold"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/txtTelefono"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="#FFFFFF"
                android:textColor="#051F20"
                android:paddingHorizontal="14dp"
                android:elevation="1dp"
                android:inputType="phone" />

            <TextView
                android:id="@+id/lblCorreo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Correo Electrónico:"
                android:textColor="#051F20"
                android:textStyle="bold"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/txtCorreo"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="#FFFFFF"
                android:textColor="#051F20"
                android:paddingHorizontal="14dp"
                android:elevation="1dp"
                android:inputType="textEmailAddress" />

            <TextView
                android:id="@+id/lblUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Usuario:"
                android:textColor="#051F20"
                android:textStyle="bold"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/txtUsuario"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="#FFFFFF"
                android:textColor="#051F20"
                android:paddingHorizontal="14dp"
                android:elevation="1dp"
                android:inputType="text" />

            <TextView
                android:id="@+id/lblContrasena"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Contraseña:"
                android:textColor="#051F20"
                android:textStyle="bold"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/txtContrasena"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="#FFFFFF"
                android:textColor="#051F20"
                android:paddingHorizontal="14dp"
                android:elevation="1dp"
                android:inputType="textPassword" />

            <TextView
                android:id="@+id/lblRepContrasena"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Repetir la Contraseña:"
                android:textColor="#051F20"
                android:textStyle="bold"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/txtRepContrasena"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="#FFFFFF"
                android:textColor="#051F20"
                android:paddingHorizontal="14dp"
                android:elevation="1dp"
                android:inputType="textPassword" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Tipo de Personal:"
                android:textColor="#051F20"
                android:textStyle="bold"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/cboPersonal"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="#FFFFFF"
                android:elevation="1dp" />

            <Button
                android:id="@+id/BtnRegistrarse"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="Registrarse"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0B2B26"
                app:cornerRadius="14dp" />

            <TextView
                android:id="@+id/lblRegresar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:text="← Regresar al inicio"
                android:textColor="#163832"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
