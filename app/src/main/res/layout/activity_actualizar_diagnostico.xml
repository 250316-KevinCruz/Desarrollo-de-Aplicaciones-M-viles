<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DAF1DE"
    tools:context=".ActualizarDiagnostico">

    <!-- Encabezado con Logo Circular Vet -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/vet"
                android:scaleType="centerCrop"
                android:contentDescription="Logo Clínica" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clinica del Tio Randy"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#051F20"
            android:layout_marginStart="14dp" />
    </LinearLayout>

    <!-- SECCIÓN: Diagnostico -->
    <LinearLayout
        android:id="@+id/sectionLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/diagnostico"
            android:contentDescription="Icono Diagnóstico" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Actualizar Diagnóstico"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#0B2B26"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- FORMULARIO SCROLLABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/sectionLayout"
        app:layout_constraintBottom_toTopOf="@id/btnActualizar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/formLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tipo de diagnóstico:"
                android:textColor="#051F20"
                android:textStyle="bold"
                android:textSize="12sp" />
            <Spinner
                android:id="@+id/spDiagnostico"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="#FFFFFF"
                android:elevation="1dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Síntomas presentados:"
                android:textColor="#051F20"
                android:textStyle="bold"
                android:textSize="12sp" />
            <EditText
                android:id="@+id/etSintomas"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:inputType="text"
                android:textColor="#051F20"
                android:background="#FFFFFF"
                android:elevation="1dp"
                android:paddingHorizontal="10dp"
                android:layout_marginBottom="6dp" />

            <!-- Fila Temperatura y Peso -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Temperatura (°C):"
                        android:textColor="#051F20"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                    <EditText
                        android:id="@+id/etTemperatura"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:inputType="numberDecimal"
                        android:textColor="#051F20"
                        android:background="#FFFFFF"
                        android:elevation="1dp"
                        android:paddingHorizontal="10dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Peso (kg):"
                        android:textColor="#051F20"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                    <EditText
                        android:id="@+id/etPeso"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:inputType="numberDecimal"
                        android:textColor="#051F20"
                        android:background="#FFFFFF"
                        android:elevation="1dp"
                        android:paddingHorizontal="10dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Diagnóstico Médico:"
                android:textColor="#051F20"
                android:textStyle="bold"
                android:textSize="12sp" />
            <EditText
                android:id="@+id/etDiagnosticoMedico"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:inputType="text"
                android:textColor="#051F20"
                android:background="#FFFFFF"
                android:elevation="1dp"
                android:paddingHorizontal="10dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nivel de Gravedad:"
                android:textColor="#051F20"
                android:textStyle="bold"
                android:textSize="12sp" />
            <Spinner
                android:id="@+id/spGravedad"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="#FFFFFF"
                android:elevation="1dp"
                android:layout_marginBottom="6dp" />

            <!-- Fila Fecha y Hora -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fecha:"
                        android:textColor="#051F20"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                    <EditText
                        android:id="@+id/etFecha"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:inputType="date"
                        android:textColor="#051F20"
                        android:background="#FFFFFF"
                        android:elevation="1dp"
                        android:paddingHorizontal="10dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hora:"
                        android:textColor="#051F20"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                    <EditText
                        android:id="@+id/etHora"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:inputType="time"
                        android:textColor="#051F20"
                        android:background="#FFFFFF"
                        android:elevation="1dp"
                        android:paddingHorizontal="10dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estado de tratamiento:"
                android:textColor="#051F20"
                android:textStyle="bold"
                android:textSize="12sp" />
            <Spinner
                android:id="@+id/spEstado"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="#FFFFFF"
                android:elevation="1dp"
                android:layout_marginBottom="4dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Botón Actualizar -->
    <Button
        android:id="@+id/btnActualizar"
        android:layout_width="220dp"
        android:layout_height="46dp"
        android:text="Actualizar Diagnóstico"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:backgroundTint="#0B2B26"
        app:cornerRadius="14dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@id/bottomLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="#0B2B26"
        android:elevation="8dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/cliente" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clientes"
                android:textSize="10sp"
                android:textColor="#DAF1DE"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/pata" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mascotas"
                android:textSize="10sp"
                android:textColor="#DAF1DE"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/diagnostico" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diagnóstico"
                android:textSize="10sp"
                android:textColor="#DAF1DE"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ajuste" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajustes"
                android:textSize="10sp"
                android:textColor="#DAF1DE"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
