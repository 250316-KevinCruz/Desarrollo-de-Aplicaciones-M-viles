<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DAF1DE"
    tools:context=".Login">

    <!-- Logo Circular de Vet -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardLogo"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="42dp"
        app:cardCornerRadius="70dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Imagen de login"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/vet" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/lblTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Clinica del Tio Randy"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#051F20"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardLogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/lblSubtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Iniciar Sesión"
        android:textSize="15sp"
        android:textColor="#163832"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/lblTitulo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Campo Usuario -->
    <TextView
        android:id="@+id/lblUsuario"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Usuario"
        android:textColor="#051F20"
        android:textStyle="bold"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblSubtitulo"/>

    <EditText
        android:id="@+id/txtUsuario"
        android:layout_width="320dp"
        android:layout_height="50dp"
        android:layout_marginTop="6dp"
        android:background="#FFFFFF"
        android:textColor="#051F20"
        android:textColorHint="#8EB69B"
        android:hint="Ingresa tu usuario"
        android:paddingHorizontal="16dp"
        android:elevation="2dp"
        android:inputType="textPersonName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblUsuario"/>

    <!-- Campo Contraseña -->
    <TextView
        android:id="@+id/lblPassword"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Contraseña"
        android:textColor="#051F20"
        android:textStyle="bold"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtUsuario"/>

    <EditText
        android:id="@+id/txtPassword"
        android:layout_width="320dp"
        android:layout_height="50dp"
        android:layout_marginTop="6dp"
        android:background="#FFFFFF"
        android:textColor="#051F20"
        android:textColorHint="#8EB69B"
        android:hint="••••••••"
        android:paddingHorizontal="16dp"
        android:elevation="2dp"
        android:inputType="textPassword"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblPassword"/>

    <!-- Recuperar Contraseña -->
    <TextView
        android:id="@+id/lblRecuperarContrasena"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="¿Olvidaste tu contraseña?"
        android:textColor="#235347"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/txtPassword"
        app:layout_constraintTop_toBottomOf="@id/txtPassword"/>

    <!-- Botón Ingresar -->
    <Button
        android:id="@+id/btnIngresar"
        android:layout_width="320dp"
        android:layout_height="52dp"
        android:text="Ingresar"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0B2B26"
        app:cornerRadius="14dp"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblRecuperarContrasena"/>

    <!-- Crear Cuenta -->
    <TextView
        android:id="@+id/lblCrearCuenta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="¿No tienes cuenta? Regístrate aquí"
        android:textColor="#163832"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnIngresar"/>

</androidx.constraintlayout.widget.ConstraintLayout>